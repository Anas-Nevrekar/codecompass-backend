# Copy to .env.production, fill secrets, and keep that file out of version control.
# Use a URL-safe database password; keep POSTGRES_* and DATABASE_URL in sync.
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-frontend.example.com
POSTGRES_DB=codecompass
POSTGRES_USER=codecompass
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
DATABASE_URL=postgresql://codecompass:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@postgres:5432/codecompass
REDIS_URL=redis://redis:6379
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
GITHUB_CALLBACK_URL=https://your-api.example.com/api/auth/github/callback
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
INDEXING_CLONE_TIMEOUT_MS=120000
INDEXING_MAX_REPOSITORY_SIZE_MB=500
INDEXING_MAX_FILE_SIZE_MB=2
INDEXING_WORKER_CONCURRENCY=1
INDEXING_TEMP_DIR=
INDEXING_REPOSITORY_STORAGE_DIR=/var/lib/codecompass/repository-storage
INDEXING_STALE_TEMP_DIR_AGE_HOURS=24
INDEXING_RECOVERY_INTERVAL_MS=30000
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_INPUT_CHARS=100000
EMBEDDING_WORKER_CONCURRENCY=1
EMBEDDING_REQUEST_TIMEOUT_MS=120000
HYBRID_SEARCH_VECTOR_LIMIT=20
HYBRID_SEARCH_KEYWORD_LIMIT=20
HYBRID_SEARCH_DEFAULT_LIMIT=10
HYBRID_SEARCH_RRF_K=60
LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
LLM_MODEL=gemini-3.8-flash
LLM_MAX_OUTPUT_TOKENS=1500
LLM_REQUEST_TIMEOUT_MS=60000
RAG_RETRIEVAL_LIMIT=10
RAG_MAX_CONTEXT_TOKENS=12000
RAG_MAX_QUESTION_LENGTH=2000
RAG_ENABLE_STREAMING=true
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPUS=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPUS=0.5
API_MEMORY_LIMIT=768m
API_CPUS=1.0
INDEXING_MEMORY_LIMIT=1g
INDEXING_CPUS=1.0
PARSING_MEMORY_LIMIT=768m
PARSING_CPUS=1.0
EMBEDDING_WORKER_MEMORY_LIMIT=1g
EMBEDDING_WORKER_CPUS=1.0
