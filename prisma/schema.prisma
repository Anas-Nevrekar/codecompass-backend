generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(uuid()) @db.Uuid
  githubId       BigInt             @unique
  githubUsername String
  displayName    String?
  avatarUrl      String?
  profileUrl     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  repositories   RepositoryImport[]
  indexingJobs   IndexingJob[]
}

model Repository {
  id                String             @id @default(uuid()) @db.Uuid
  githubId          BigInt             @unique
  owner             String
  name              String
  fullName          String
  htmlUrl           String
  description       String?
  defaultBranch     String?
  language          String?
  visibility        String             @default("public")
  starsCount        Int                @default(0)
  forksCount        Int                @default(0)
  githubCreatedAt   DateTime?
  metadataUpdatedAt DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  imports           RepositoryImport[]
  indexingJobs      IndexingJob[]
  files             RepositoryFile[]
  lastIndexedCommitSha String?
  lastIndexedAt     DateTime?
  lastIndexedFileCount Int?
}

model RepositoryImport {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  repositoryId String     @db.Uuid
  importedAt   DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId, importedAt])
}

enum IndexingStatus {
  queued
  cloning
  filtering
  saving_inventory
  completed
  failed
}

model IndexingJob {
  id                    String         @id @default(uuid()) @db.Uuid
  repositoryId          String         @db.Uuid
  userId                String         @db.Uuid
  activeRepositoryId    String?        @unique @db.Uuid
  status                IndexingStatus @default(queued)
  progress              Int            @default(0)
  stage                 String         @default("queued")
  message               String         @default("Waiting to start")
  discoveredFileCount   Int            @default(0)
  eligibleFileCount     Int            @default(0)
  excludedFileCount     Int            @default(0)
  attemptCount          Int            @default(0)
  maxAttempts           Int            @default(3)
  errorCode             String?
  errorMessage          String?
  bullmqJobId           String         @unique
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  repository            Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  files                 RepositoryFile[]

  @@index([status, createdAt])
  @@index([repositoryId, createdAt])
  @@index([userId, createdAt])
}

model RepositoryFile {
  id              String       @id @default(uuid()) @db.Uuid
  repositoryId    String       @db.Uuid
  indexingJobId   String       @db.Uuid
  relativePath    String
  extension       String
  category        String
  sizeBytes       BigInt
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  repository      Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  indexingJob     IndexingJob  @relation(fields: [indexingJobId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, relativePath])
  @@index([repositoryId])
  @@index([indexingJobId])
  @@index([extension])
  @@index([category])
}
