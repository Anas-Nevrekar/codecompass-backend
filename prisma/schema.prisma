generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(uuid()) @db.Uuid
  githubId       BigInt             @unique
  githubUsername String
  displayName    String?
  avatarUrl      String?
  profileUrl     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  repositories   RepositoryImport[]
  indexingJobs   IndexingJob[]
  readingProgress ReadingProgress[]
}

model Repository {
  id                String             @id @default(uuid()) @db.Uuid
  githubId          BigInt             @unique
  owner             String
  name              String
  fullName          String
  htmlUrl           String
  description       String?
  defaultBranch     String?
  language          String?
  visibility        String             @default("public")
  starsCount        Int                @default(0)
  forksCount        Int                @default(0)
  githubCreatedAt   DateTime?
  metadataUpdatedAt DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  imports           RepositoryImport[]
  indexingJobs      IndexingJob[]
  files             RepositoryFile[]
  lastIndexedCommitSha String?
  lastIndexedAt     DateTime?
  lastIndexedFileCount Int?
  retainedStoragePath String?
  deletionRequestedAt DateTime?
  parsingJobs ParsingJob[]
  codeChunks CodeChunk[]
  codeEmbeddings CodeEmbedding[]
  embeddingJobs EmbeddingJob[]
  readingProgress ReadingProgress[]
}

model ReadingProgress {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  repositoryId   String     @db.Uuid
  parsingJobId   String     @db.Uuid
  activeStageId  String?
  statusByStage  Json       @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId, parsingJobId])
}

model RepositoryImport {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  repositoryId String     @db.Uuid
  importedAt   DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId, importedAt])
}

enum IndexingStatus {
  queued
  cloning
  filtering
  saving_inventory
  completed
  failed
}

model IndexingJob {
  id                    String         @id @default(uuid()) @db.Uuid
  repositoryId          String         @db.Uuid
  userId                String         @db.Uuid
  activeRepositoryId    String?        @unique @db.Uuid
  status                IndexingStatus @default(queued)
  progress              Int            @default(0)
  stage                 String         @default("queued")
  message               String         @default("Waiting to start")
  discoveredFileCount   Int            @default(0)
  eligibleFileCount     Int            @default(0)
  excludedFileCount     Int            @default(0)
  attemptCount          Int            @default(0)
  maxAttempts           Int            @default(3)
  errorCode             String?
  errorMessage          String?
  bullmqJobId           String         @unique
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  repository            Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  files                 RepositoryFile[]
  parsingJobs           ParsingJob[]

  @@index([status, createdAt])
  @@index([repositoryId, createdAt])
  @@index([userId, createdAt])
}

model RepositoryFile {
  id              String       @id @default(uuid()) @db.Uuid
  repositoryId    String       @db.Uuid
  indexingJobId   String       @db.Uuid
  relativePath    String
  extension       String
  category        String
  sizeBytes       BigInt
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  repository      Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  indexingJob     IndexingJob  @relation(fields: [indexingJobId], references: [id], onDelete: Cascade)
  parsingResults ParsingFileResult[]

  @@unique([repositoryId, indexingJobId, relativePath])
  @@index([repositoryId])
  @@index([indexingJobId])
  @@index([extension])
  @@index([category])
  codeChunks CodeChunk[]
}

enum ParsingStatus {
  queued
  processing
  completed
  completed_with_errors
  failed
}

model ParsingJob {
  id             String        @id @default(uuid()) @db.Uuid
  repositoryId   String        @db.Uuid
  indexingJobId  String        @db.Uuid
  status         ParsingStatus @default(queued)
  stage          String        @default("queued")
  progress       Int           @default(0)
  totalFiles     Int           @default(0)
  processedFiles Int           @default(0)
  parsedFiles    Int           @default(0)
  skippedFiles   Int           @default(0)
  failedFiles    Int           @default(0)
  totalChunks    Int           @default(0)
  errorMessage   String?
  bullmqJobId    String        @unique
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  repository     Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  indexingJob    IndexingJob   @relation(fields: [indexingJobId], references: [id], onDelete: Cascade)
  chunks         CodeChunk[]
  fileResults    ParsingFileResult[]
  embeddingJobs  EmbeddingJob[]
  @@index([repositoryId, createdAt])
  @@index([status, createdAt])
}

model CodeChunk {
  id           String      @id @default(uuid()) @db.Uuid
  parsingJobId String      @db.Uuid
  repositoryId String      @db.Uuid
  fileId       String      @db.Uuid
  relativePath String
  language     String
  structureType String
  symbolName   String?
  startLine    Int
  endLine      Int
  source       String      @db.Text
  metadata     Json        @default("{}")
  sourceHash   String
  createdAt    DateTime    @default(now())
  parsingJob   ParsingJob  @relation(fields: [parsingJobId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file         RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  @@unique([parsingJobId, fileId, structureType, startLine, endLine, sourceHash])
  @@index([repositoryId, parsingJobId])
  @@index([fileId])
  embeddings CodeEmbedding[]
}

model ParsingFileResult {
  id           String     @id @default(uuid()) @db.Uuid
  parsingJobId String     @db.Uuid
  fileId       String     @db.Uuid
  status       String
  errorMessage String?
  chunkCount   Int        @default(0)
  createdAt    DateTime   @default(now())
  parsingJob   ParsingJob @relation(fields: [parsingJobId], references: [id], onDelete: Cascade)
  file         RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  @@unique([parsingJobId, fileId])
}

enum EmbeddingStatus {
  queued
  processing
  completed
  completed_with_errors
  failed
}

model EmbeddingJob {
  id              String          @id @default(uuid()) @db.Uuid
  repositoryId    String          @db.Uuid
  parsingJobId    String          @db.Uuid
  status          EmbeddingStatus @default(queued)
  stage           String          @default("queued")
  progress        Int             @default(0)
  totalChunks     Int             @default(0)
  processedChunks Int             @default(0)
  embeddedChunks  Int             @default(0)
  skippedChunks   Int             @default(0)
  failedChunks    Int             @default(0)
  errorMessage    String?
  bullmqJobId     String          @unique
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  repository      Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  parsingJob      ParsingJob     @relation(fields: [parsingJobId], references: [id], onDelete: Cascade)
  @@index([repositoryId, createdAt])
  @@index([status, createdAt])
}

model CodeEmbedding {
  id                  String     @id @default(uuid()) @db.Uuid
  codeChunkId         String     @db.Uuid
  repositoryId        String     @db.Uuid
  embeddingModel      String
  embeddingDimensions Int
  embedding           Unsupported("vector(768)")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  codeChunk           CodeChunk  @relation(fields: [codeChunkId], references: [id], onDelete: Cascade)
  repository          Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  @@unique([codeChunkId, embeddingModel, embeddingDimensions])
  @@index([repositoryId, embeddingModel, embeddingDimensions])
}
