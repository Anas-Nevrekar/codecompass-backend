NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

POSTGRES_DB=codecompass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codecompass

REDIS_URL=redis://localhost:6379

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
SESSION_SECRET=

# Background indexing worker limits
INDEXING_CLONE_TIMEOUT_MS=120000
INDEXING_MAX_REPOSITORY_SIZE_MB=500
INDEXING_MAX_FILE_SIZE_MB=2
INDEXING_WORKER_CONCURRENCY=2
INDEXING_TEMP_DIR=
# Defaults to ../codecompass-repository-storage beside codecompass-backend.
INDEXING_REPOSITORY_STORAGE_DIR=
INDEXING_STALE_TEMP_DIR_AGE_HOURS=24
INDEXING_RECOVERY_INTERVAL_MS=30000

# Local Ollama embeddings (the service runs outside Docker during development)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_INPUT_CHARS=100000
EMBEDDING_WORKER_CONCURRENCY=1
EMBEDDING_REQUEST_TIMEOUT_MS=120000
HYBRID_SEARCH_VECTOR_LIMIT=20
HYBRID_SEARCH_KEYWORD_LIMIT=20
HYBRID_SEARCH_DEFAULT_LIMIT=10
HYBRID_SEARCH_RRF_K=60

# Gemini hosted answer generation (keep LLM_API_KEY private and out of source control)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_MAX_OUTPUT_TOKENS=1500
LLM_REQUEST_TIMEOUT_MS=60000
RAG_RETRIEVAL_LIMIT=10
RAG_MAX_CONTEXT_TOKENS=12000
RAG_MAX_QUESTION_LENGTH=2000
RAG_ENABLE_STREAMING=true
