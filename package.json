{
  "name": "codecompass-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend foundation for CodeCompass",
  "engines": { "node": ">=20" },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.58.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "supertest": "^7.1.4"
  }
}
